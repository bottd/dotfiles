{
  config,
  lib,
  hostName,
  features,
  ...
}:
# mango's compositor config. The shell around it (Quickshell, mako, swaylock,
# wallpaper) is the niri module's, which mango hosts import too. Binds follow
# niri's (home/linux/niri/default.nix) so muscle memory carries over; the
# scroller layout is mango's take on niri's columns.
let
  press = config.lib.ditherPress;
  # "#rrggbb" -> mango's 0xrrggbbaa.
  hex = alpha: color: "0x${lib.removePrefix "#" color}${alpha}";
  solid = hex "ff";

  showLevel = kind: "qs ipc call levels ${kind}";

  # Tags 1-9: Mod+N views, Mod+Shift+N moves the window there.
  tagBinds = lib.concatMapStrings (i: ''
    bind=SUPER,${toString i},view,${toString i},0
    bind=SUPER+SHIFT,${toString i},tag,${toString i},0
  '') (lib.range 1 9);

  # Same layout as home/linux/niri/host/desktop.nix: DP-3 is the portrait
  # panel to the right (wlroots transform 3 = niri's rotation 270).
  # DP-1 is pinned to 144: its preferred mode is the 170 Hz overclock, and
  # both 170 and 165 tear in every app.
  outputs = lib.optionalString (hostName == "desktop") ''
    monitorrule=name:^DP-1$,width:2560,height:1440,refresh:143.912003,x:0,y:282,scale:1
    monitorrule=name:^DP-3$,width:2560,height:1440,x:2560,y:0,scale:1,rr:3
    ${lib.concatMapStrings (i: ''
      tagrule=id:${toString i},monitor_name:DP-3,layout_name:vertical_scroller
    '') (lib.range 1 9)}
  '';
in
{
  xdg.configFile."mango/config.conf".text = ''
    # Generated by home/linux/mango.nix. Mod+Shift+R reloads.

    # Tags scroll like niri's columns; the portrait panel's rules follow.
    ${lib.concatMapStrings (i: ''
      tagrule=id:${toString i},layout_name:scroller
    '') (lib.range 1 9)}
    ${outputs}

    exec-once=nm-applet --indicator

    # ---- Dither Press: ink keyline, offset plate, square trims ----------
    border_radius=0
    borderpx=4
    focuscolor=${solid press.colors.ink}
    bordercolor=${solid press.colors.hover}
    urgentcolor=${solid press.colors.danger}
    rootcolor=${solid press.colors.paper}
    maximizescreencolor=${solid press.colors.ink}
    scratchpadcolor=${solid press.colors.plate}
    globalcolor=${solid press.colors.plate}
    overlaycolor=${solid press.colors.plate}

    # Hard offset plate behind every window, never blur.
    shadows=1
    shadow_only_floating=0
    layer_shadows=0
    shadows_size=0
    shadows_blur=0
    shadows_position_x=8
    shadows_position_y=8
    shadowscolor=${solid press.colors.plate}
    blur=0

    gappih=16
    gappiv=16
    gappoh=16
    gappov=16

    # ---- Animations --------------------------------------------------------
    animations=${if features.animations then "1" else "0"}
    layer_animations=0
    animation_type_open=slide
    animation_type_close=slide
    animation_fade_in=1
    animation_fade_out=1
    animation_duration_open=260
    animation_duration_close=200
    animation_duration_move=220
    animation_duration_tag=220
    animation_duration_focus=0

    # ---- Scroller (niri-like columns) --------------------------------------
    scroller_structs=16
    scroller_default_proportion=1.0
    scroller_ignore_proportion_single=1
    scroller_focus_center=0
    scroller_prefer_center=0
    edge_scroller_pointer_focus=1
    scroller_proportion_preset=0.33333,0.5,0.66667,1.0

    # ---- Input -------------------------------------------------------------
    xkb_rules_layout=us
    repeat_rate=25
    repeat_delay=600
    sloppyfocus=1
    warpcursor=1
    focus_on_activate=1
    tap_to_click=1
    tap_and_drag=1
    trackpad_natural_scrolling=1

    # Overview on a hot corner as well as Mod+O.
    enable_hotarea=1
    overviewgappi=16
    overviewgappo=32

    # ---- Binds (mirrors niri) ----------------------------------------------
    bind=SUPER,Return,spawn,ghostty
    bind=SUPER,d,spawn,qs ipc call launcher toggle
    bind=SUPER,b,spawn,qs ipc call web toggle
    bind=SUPER,space,spawn,qs ipc call key-overlay toggle
    bind=NONE,XF86Tools,spawn,qs ipc call key-overlay toggle
    ${lib.optionalString features.gaming "bind=SUPER,g,spawn,qs ipc call games toggle"}
    bind=SUPER,q,killclient
    bind=SUPER+ALT,l,spawn,swaylock

    bind=SUPER,h,focusdir,left
    bind=SUPER,l,focusdir,right
    bind=SUPER,j,focusdir,down
    bind=SUPER,k,focusdir,up
    bind=SUPER+SHIFT,h,exchange_client,left
    bind=SUPER+SHIFT,l,exchange_client,right
    bind=SUPER+SHIFT,j,exchange_client,down
    bind=SUPER+SHIFT,k,exchange_client,up

    bind=SUPER+CTRL,h,focusmon,left
    bind=SUPER+CTRL,l,focusmon,right
    bind=SUPER+SHIFT+CTRL,h,tagmon,left
    bind=SUPER+SHIFT+CTRL,l,tagmon,right

    bind=SUPER,u,viewtoright,0
    bind=SUPER,i,viewtoleft,0
    ${tagBinds}
    bind=SUPER,f,togglemaximizescreen
    bind=SUPER+SHIFT,f,togglefullscreen
    bind=SUPER,r,switch_proportion_preset
    bind=SUPER,comma,scroller_stack,left
    bind=SUPER,period,scroller_stack,right
    bind=SUPER+SHIFT,space,togglefloating
    bind=SUPER,o,toggleoverview
    bind=SUPER,n,switch_layout

    bind=NONE,Print,spawn_shell,grim -g "$(slurp)" ~/Pictures/Screenshots/Screenshot-$(date +%Y-%m-%d-%H-%M-%S).png
    bind=SUPER,Print,spawn_shell,grim ~/Pictures/Screenshots/Screenshot-$(date +%Y-%m-%d-%H-%M-%S).png

    bindl=NONE,XF86AudioRaiseVolume,spawn_shell,wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+; ${showLevel "volume"}
    bindl=NONE,XF86AudioLowerVolume,spawn_shell,wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-; ${showLevel "volume"}
    bindl=NONE,XF86AudioMute,spawn_shell,wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; ${showLevel "volume"}
    bindl=NONE,XF86AudioMicMute,spawn,wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    bindl=NONE,XF86MonBrightnessUp,spawn_shell,brightness up; ${showLevel "brightness"}
    bindl=NONE,XF86MonBrightnessDown,spawn_shell,brightness down; ${showLevel "brightness"}
    bindl=NONE,XF86AudioPlay,spawn,playerctl play-pause
    bindl=NONE,XF86AudioNext,spawn,playerctl next
    bindl=NONE,XF86AudioPrev,spawn,playerctl previous

    bind=SUPER+SHIFT,r,reload_config
    bind=SUPER+SHIFT,e,quit

    mousebind=SUPER,btn_left,moveresize,curmove
    mousebind=SUPER,btn_right,moveresize,curresize
    axisbind=SUPER,UP,viewtoleft_have_client
    axisbind=SUPER,DOWN,viewtoright_have_client
  '';
}
