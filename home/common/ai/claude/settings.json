{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": ["mcp__nixos__*"]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "improve@improve": true,
    "lazyweb@lazyweb": true,
    "impeccable@impeccable": true,
    "humanizer@humanizer": true
  },
  "extraKnownMarketplaces": {
    "improve": {
      "source": {
        "source": "github",
        "repo": "shadcn/improve"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [".", "~/loam"],
      "denyWrite": ["/"],
      "denyRead": ["~/"],
      "allowRead": [".", "~/dotfiles", "~/workspace", "~/loam", "~/remote"]
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "nixos": {
      "command": "mcp-nixos"
    }
  },
  "plugins": {},
  "preferNativeInstaller": false
}
